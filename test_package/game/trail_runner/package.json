{
  "mod_id": "test.trail_runner",
  "schema_version": 1,
  "type": "game",
  "version": "1.1.0",
  "version_code": 2,
  "api": { "min": 1, "max": 1 },
  "entry": "main",
  "display": {
    "title": { "type": "i18n", "path": "display.json", "key": "title", "callback": "Trail Runner" },
    "description": { "type": "i18n", "path": "display.json", "key": "description", "callback": "Steer a growing trail and collect gems." },
    "author": "TUI GAME"
  },
  "runtime": { "min_width": 60, "min_height": 20 },
  "game": {
    "name": "f%<fg:bright_green>Trail</fg> Runner",
    "detail": { "type": "i18n", "path": "display.json", "key": "detail", "callback": "Steer the runner, collect gems and never cross your own trail." },
    "high_privilege": false,
    "mouse": false,
    "truecolor": false,
    "target_fps": 60,
    "save": true,
    "language": ["en_us", "zh_cn"],
    "score": { "enabled": true, "empty_text": { "type": "i18n", "path": "display.json", "key": "empty_score", "callback": "No trail record yet" } },
    "actions": {
      "move_up": { "description": "Steer up", "keys": [["w"], ["up"]] },
      "move_down": { "description": "Steer down", "keys": [["s"], ["down"]] },
      "move_left": { "description": "Steer left", "keys": [["a"], ["left"]] },
      "move_right": { "description": "Steer right", "keys": [["d"], ["right"]] },
      "pause": { "description": "Pause or resume", "keys": [["space"]] },
      "leave": { "description": "Return to game list", "keys": [["esc"]], "lock": true }
    }
  }
}
